# Automation settings
# WARNING: keep MT5_SHARED_SECRET secret. Match this value in your EA's SharedSecret input.
ENABLE_AUTO_EXECUTION=false
BROKER=mt5
MT5_SHARED_SECRET=change_me

# MT5 symbol mapping and formatting
# If your broker uses custom symbols (e.g. BTCUSDz), populate MT5_SYMBOL_MAP_JSON
# Example single-line JSON: {"BTCUSD":"BTCUSDz","ETHUSD":"ETHUSDz"}
MT5_SYMBOL_PREFIX=
MT5_SYMBOL_SUFFIX=
MT5_SYMBOL_MAP_JSON={"BTCUSD":"BTCUSDz","ETHUSD":"ETHUSDz","XAUUSD":"XAUUSD"}

# MT5 lot sizing safety defaults (tune to your broker)
MT5_MIN_LOT=0.01
MT5_MAX_LOT=2
MT5_LOT_STEP=0.01

# Concurrency / safety
MAX_CONCURRENT_TRADES=2

# Background autotrade controls
BACKGROUND_AUTOTRADE_ENABLED=false
BACKGROUND_POLL_INTERVAL_MS=20000
BACKGROUND_ALL_SYMBOLS=false
BACKGROUND_MARKETS=forex,crypto,indices,metals
BACKGROUND_TIMEFRAME=M15
BACKGROUND_TRADE_MODE=day
BACKGROUND_ACCOUNT_BALANCE=5000
BACKGROUND_RISK_PERCENT=5

# Binance credentials (only needed when BROKER=binance)
BINANCE_API_KEY=your_api_key
BINANCE_API_SECRET=your_api_secret
